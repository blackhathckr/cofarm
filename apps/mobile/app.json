{
  "expo": {
    "name": "CoFarm",
    "slug": "cofarm",
    "scheme": "cofarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#f5ead8",
    "primaryColor": "#c67139",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "kiaan.cofarm.partner",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "CoFarm"
      }
    },
    "android": {
      "package": "kiaan.cofarm.partner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5ead8"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#c67139"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
