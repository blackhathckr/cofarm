{
  "name": "@cofarm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx --env-file=../../.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:seed:demo": "tsx --env-file=../../.env src/db/seed-demo.ts",
    "db:reset": "tsx --env-file=../../.env src/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "db:truncate": "tsx --env-file=../../.env src/db/truncate.ts",
    "db:seed:production": "tsx --env-file=../../.env src/db/seed-production.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@cofarm/contracts": "workspace:*",
    "@cofarm/core": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@react-pdf/renderer": "4.9.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "react": "19.2.3",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cofarm/tsconfig": "workspace:*",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
