# Production template. The live file is /var/www/repos/cofarm/.env on the VM,
# is never committed, and is read by both pm2 and tsx's --env-file.
# Lines marked SECRET hold real credentials: fill them on the VM only.

NODE_ENV=production
LOG_LEVEL=info

# ── API ── nginx fronts this, so it must never bind 0.0.0.0.
API_PORT=4020
API_HOST=127.0.0.1
# Origins allowed to call the API. The admin console is same-origin behind
# nginx; the mobile app sends no Origin.
CORS_ORIGINS=https://admin.cofarm.farm
RATE_LIMIT_PER_MINUTE=1200

# ── Database ── Postgres 16 native on the VM. SECRET: holds the role password.
DATABASE_URL=postgres://cofarm:REPLACE_ME@127.0.0.1:5432/cofarm

# ── Tokens ── SECRET. 32+ chars. Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_ME_WITH_48_RANDOM_BYTES_BASE64
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Object storage (Cloudflare R2) ── SECRET: ACCESS_KEY and SECRET_KEY.
STORAGE_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=cofarm-documents
STORAGE_ACCESS_KEY=REPLACE_ME
STORAGE_SECRET_KEY=REPLACE_ME
STORAGE_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=300

# ── OTP delivery ── Message Central Verify Now issues and validates the code.
AUTH_PROVIDER=message_central
MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com
MESSAGE_CENTRAL_CUSTOMER_ID=REPLACE_ME
# SECRET: the account password, base-64 encoded.
MESSAGE_CENTRAL_KEY=REPLACE_ME
MESSAGE_CENTRAL_COUNTRY=IN
MESSAGE_CENTRAL_COUNTRY_CODE=91
MESSAGE_CENTRAL_FLOW_TYPE=SMS
MESSAGE_CENTRAL_OTP_LENGTH=6
# Read only when AUTH_PROVIDER=dev; left at the schema default in production.
DEV_OTP_CODE=000000

# ── Push ── SECRET: FCM_PRIVATE_KEY, the service-account PEM with \n escaped.
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=REPLACE_ME
FCM_CLIENT_EMAIL=REPLACE_ME@REPLACE_ME.iam.gserviceaccount.com
FCM_PRIVATE_KEY=REPLACE_ME

# ── Business rules ── Kiaan's share of net proceeds; the rest is the partner pool.
KIAAN_SHARE_PCT=50

# ── Seeds ── read only by db:seed*, which never runs in production. SECRET.
SEED_ADMIN_EMAIL=admin@cofarm.farm
SEED_ADMIN_PASSWORD=REPLACE_ME
