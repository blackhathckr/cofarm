# Copy to .env — never commit the real file.

NODE_ENV=development
LOG_LEVEL=debug

# ── API ──
API_PORT=4000
API_HOST=0.0.0.0
# Origins allowed to call the API (admin console in dev).
CORS_ORIGINS=http://localhost:5173
# Blunt per-IP ceiling. The real controls are per-mobile (OTP) and per-route.
RATE_LIMIT_PER_MINUTE=1200

# ── Database ──
DATABASE_URL=postgres://cofarm:cofarm@localhost:5433/cofarm

# ── Tokens ──
# 32+ bytes. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Object storage (MinIO locally, S3 in production) ──
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=cofarm-documents
STORAGE_ACCESS_KEY=cofarm
STORAGE_SECRET_KEY=cofarm-local-secret
STORAGE_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ── Provider seams: 'dev' keeps everything local and account-free ──
# dev = fixed OTP printed to the log
# message_central = Verify Now generates, sends and validates the code
# firebase = the handset completes the exchange
AUTH_PROVIDER=dev
DEV_OTP_CODE=000000

# Message Central Verify Now. KEY is the account password, base-64 encoded.
MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_KEY=
MESSAGE_CENTRAL_COUNTRY=IN
MESSAGE_CENTRAL_COUNTRY_CODE=91
MESSAGE_CENTRAL_FLOW_TYPE=SMS
MESSAGE_CENTRAL_OTP_LENGTH=6

# log = push recorded in the notifications table only; fcm = real delivery
PUSH_PROVIDER=log
# From the Firebase service-account JSON. Keep the PEM newlines escaped as 
.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Business rules ──
# Share of net proceeds retained by Kiaan; the remainder is the partner pool.
KIAAN_SHARE_PCT=50

# ── Seeded superadmin (development only) ──
SEED_ADMIN_EMAIL=admin@cofarm.local
SEED_ADMIN_PASSWORD=cofarm-dev-admin
